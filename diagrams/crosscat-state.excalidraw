    {"id":"pack-desc","type":"text","x":40,"y":512,"width":700,"height":36,"text":"Same logical data as CrossCatState, but all fields are fixed-size padded JAX arrays.\nEnables jax.jit, jax.vmap, jax.lax.scan — 10-100x faster on GPU.\nDimensions: max_views × max_clusters × max_cols_per_view × max_categories","fontSize":11,"fontFamily":3,"strokeColor":"#e03131","fillStyle":"solid","roughness":0,"opacity":100,"angle":0,"seed":63,"version":1,"groupIds":[],"boundElements":null,"updated":1},

